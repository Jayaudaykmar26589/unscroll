 from sam3.sam.transformer import RoPEAttention
 from torch import nn, Tensor
 from torch.nn.attention import sdpa_kernel, SDPBackend
+
+
+# UNSCROLL: flash SDPA is not compiled into torch cu121/Windows builds, and
+# upstream forces SDPBackend.FLASH_ATTENTION exclusively. Probe once, then use
+# flash when available, else math/efficient fallback.
+_UNSCROLL_FLASH_OK = None
+
+
+def _unscroll_sdpa_fallback():
+    global _UNSCROLL_FLASH_OK
+    if _UNSCROLL_FLASH_OK is None:
+        try:
+            if torch.cuda.is_available():
+                _q = torch.zeros(1, 1, 2, 8, device="cuda", dtype=torch.float16)
+                with sdpa_kernel(SDPBackend.FLASH_ATTENTION):
+                    torchF.scaled_dot_product_attention(_q, _q, _q)
+                _UNSCROLL_FLASH_OK = True
+            else:
+                _UNSCROLL_FLASH_OK = False
+        except RuntimeError:
+            _UNSCROLL_FLASH_OK = False
+    if _UNSCROLL_FLASH_OK:
+        return sdpa_kernel(SDPBackend.FLASH_ATTENTION)
+    return sdpa_kernel([SDPBackend.MATH, SDPBackend.EFFICIENT_ATTENTION])
+
+
+# UNSCROLL: without flash, the math backend materializes the full attention
+# matrix; memory attention over several past frames then needs ~5 GB in one
+# allocation (OOM on a 16 GB T4, system-RAM spill on an 8 GB laptop). Each
+# output row depends only on its query row, so attending in query chunks is
+# exact and bounds the score matrix to ~_UNSCROLL_ATTN_BYTES.
+_UNSCROLL_ATTN_BYTES = 512 * 2 ** 20
+
+
+def _unscroll_sdpa(q, k, v, dropout_p=0.0):
+    b, h, n, _ = q.shape
+    row_bytes = b * h * k.shape[-2] * 4  # float32 softmax workspace per query row
+    rows = max(1, _UNSCROLL_ATTN_BYTES // max(row_bytes, 1))
+    if _UNSCROLL_FLASH_OK or rows >= n:
+        return torchF.scaled_dot_product_attention(q, k, v, dropout_p=dropout_p)
+    return torch.cat([torchF.scaled_dot_product_attention(q[:, :, i:i + rows], k, v, dropout_p=dropout_p)
+                      for i in range(0, n, rows)], dim=2)
 from torchvision.ops.roi_align import RoIAlign
 
 from .act_ckpt_utils import activation_ckpt_wrapper
@@ -1062,8 +1104,8 @@ def functional_attention(
         assert dropout == 0.0
         out = flash_attn_func(q.transpose(1, 2), k.transpose(1, 2), v.transpose(1, 2))
     else:
-        with sdpa_kernel(SDPBackend.FLASH_ATTENTION):
-            out = torchF.scaled_dot_product_attention(q, k, v, dropout_p=dropout)
+        with _unscroll_sdpa_fallback():  # UNSCROLL: was forced FLASH_ATTENTION
+            out = _unscroll_sdpa(q, k, v, dropout_p=dropout)  # UNSCROLL: query-chunked
         out = out.transpose(1, 2)  #  B * n * n_heads * (cv // num_heads)
 
     out = out.reshape(b, n, cv)
