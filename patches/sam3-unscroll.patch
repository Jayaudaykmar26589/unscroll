+
+
+def _edt_cv2(data):
+    """Exact CPU fallback (VENDORED PATCH)."""
+    import cv2
+    import numpy as np
+    outs = []
+    for b in range(data.shape[0]):
+        src = (data[b].detach().cpu().numpy() > 0).astype(np.uint8)
+        outs.append(cv2.distanceTransform(src, cv2.DIST_L2, 0))
+    import torch
+    return torch.from_numpy(np.stack(outs)).to(
+        data.device, torch.float32)
